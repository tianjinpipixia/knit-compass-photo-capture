        "BR-00004": "ROPÉ PICNIC",
        "BR-00006": "GLOBAL WORK",
        "BR-00012": "OPAQUE.CLIP",
        "BR-00047": "UNFILO",
        "BR-00051": "NATURAL BEAUTY BASIC",
        "BR-00054": "SLOBE IENA",
        "BR-00058": "Te chichi",
        "BR-00076": "SNIDEL"
      },
      "cadence": "DAILY_DIFF_WEEKLY_SYNTHESIS_MONTHLY_FULL_MD",
      "purpose": "High-precision reconstruction of launch timing, material transitions and knit MD structure"
    },
    "brand64_default": {
      "mode": "DIFF_ONLY_WITH_ESCALATION",
      "cadence": "DAILY_LIGHT_SCAN",
      "escalation_triggers": [
        "new_material_family",
        "new_function_claim",
        "new_shape_or_silhouette",
        "new_knit_structure",
        "meaningful_color_shift",
        "price_band_shift",
        "preorder_or_launch_pattern_change",
        "cross_brand_repeat_signal"
      ],
      "escalation_action": "TEMPORARY_DEEP_DIVE"
    }
  },
  "product_timeline": {
    "required_when_available": [
      "first_seen_date",
      "preorder_start_date",
      "preorder_end_date",
      "sales_start_date",
      "delivery_expected_date_or_month",
      "md_primary_month",
      "md_primary_event",
      "md_bucket",
      "new_color_date",
      "restock_date",
      "promotion_push_date",
      "source_offline_date"
    ],
    "date_semantics": {
      "first_seen_date": "First date Knit Compass observed the product; never substitute for sales start or preorder start without evidence.",
      "preorder_start_date": "First confirmed preorder/reservation start date. If preorder is the first commercial entry event, its month is the product's primary MD month.",
      "preorder_end_date": "Confirmed preorder/reservation close date or time when available.",
      "sales_start_date": "First confirmed normal sales start date. Use its month when there is no earlier confirmed preorder commercial entry.",
      "delivery_expected_date_or_month": "Expected delivery timing for a preorder. Supplementary timeline only; never create a second NEW launch count.",
      "md_primary_month": "Single YYYY-MM month used by proposal-workspace normal product filtering and new-launch counting.",
      "md_primary_event": "Commercial event that established md_primary_month, e.g. PREORDER_START or SALES_START.",
      "md_bucket": "MAINLINE, CARRYOVER, SPECIAL_TEST, MONTH_UNRESOLVED, or COMPETITOR_REFERENCE.",
      "new_color_date": "Date a new color is confirmed for an existing style.",
      "restock_date": "Date a restock is confirmed; preserve multiple events in observation history.",
      "promotion_push_date": "Date an existing product is re-featured in official editorial, collection or campaign content.",
      "source_offline_date": "Date the source becomes unavailable; historical product facts remain preserved."
    },
    "sales_start_evidence_levels": [
      "OFFICIAL_PRODUCT_PAGE",
      "OFFICIAL_EDITORIAL_OR_NEWS",
      "AUTHORIZED_RETAILER_EXPLICIT_DATE",
      "INFERRED_FROM_FIRST_SEEN",
      "UNKNOWN"
    ],
    "rules": {
      "prefer_explicit_sales_start": true,
      "first_seen_is_not_sales_start": true,
      "inferred_dates_must_be_labeled": true,
      "preserve_original_evidence_url": true,
      "preorder_first_commercial_entry_can_define_primary_month": true,
      "delivery_month_must_not_duplicate_new_launch_count": true,
      "unknown_month_must_not_be_guessed": true
    }
  },
  "product_detail_required_when_available": [
    "product_name",
    "product_code",
    "official_url",
